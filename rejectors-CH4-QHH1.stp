START DATA,
ORDER 1234567890XV,
SERIAL NUMBER IN COLUMNS 1-10,
CARD CHARACTERS BINARY 300000,
TEMPORARY/9999999/,

F=ADF,
DI $resp = $1-10,
di $blank = 0,

DI $Q17i = 0,
DI $A_Q17c = 0,

[*INSERT WallE_resprejector]
[*INSERT WallE_resprejectornew]

!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
