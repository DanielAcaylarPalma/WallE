DM $TQ8b1R[A]rb = $T_Q8b1_[Q8B2.A]/
7..10,7-10,
5..6,5-6,
99+R,F,
VT = "Q8b1. GENERAL FINANCIAL TRANSACTIONS METHODS (P1M) - [Q8B2STUBS.A] - REBASED",
V = "
NON-DIGITAL/ OFFLINE<Q>;
`     Cash;
`     Check;
`     Debit Card;
`     Credit Card;
DIGITAL<Q>;
`     eWallet;
`     Mobile/Online Banking;
DID NOT DO THIS TRANSACTION;
Total Count<C>",
[*END A]



[*SET Q8blen = Q8B2STUBS.#]
[*DATA averageQ8btitle (;) = 
NON-DIGITAL/ OFFLINE ONLY;
TOTAL NON-DIGITAL/ OFFLINE;
DIGITAL;
DIGITAL ONLY;
HYBRID (BOTH DIGITAL AND OFFLINE)]

[*DO u = 1:2]
[*DO A = 1:Q8blen]
DM $Q8b[u]_total[Q8B2.A] = $T_Q8b[u]_[Q8B2.A]/5..10,
DM $Q8b[u]_offlineonly[Q8B2.A] = ($T_Q8b[u]_[Q8B2.A]/7+8+9+10).N($T_Q8b[u]_[Q8B2.A]/5+6),
DM $Q8b[u]_digitalonly[Q8B2.A] = N($T_Q8b[u]_[Q8B2.A]/7+8+9+10).($T_Q8b[u]_[Q8B2.A]/5+6),
DM $Q8b[u]_hybrid[Q8B2.A] =  ($T_Q8b[u]_[Q8B2.A]/7+8+9+10).($T_Q8b[u]_[Q8B2.A]/5+6),

OM $Q8b[u]_totalrgd = $Q8b[u]_total[Q8B2.A],
OM $Q8b[u]_offlineonlyrgd = $Q8b[u]_offlineonly[Q8B2.A],
OM $Q8b[u]_digitalonlyrgd = $Q8b[u]_digitalonly[Q8B2.A],
OM $Q8b[u]_hybridrgd =  $Q8b[u]_hybrid[Q8B2.A],

DM $TQ8b[u]_inci[A] = 
$Q8b[u]_total[Q8B2.A]/NB,
$Q8b[u]_offlineonly[Q8B2.A]/NB,
$Q8b[u]_offlineonly[Q8B2.A]/NB+$Q8b[u]_hybrid[Q8B2.A]/NB,
$Q8b[u]_digitalonly[Q8B2.A]/NB+$Q8b[u]_hybrid[Q8B2.A]/NB,
$Q8b[u]_digitalonly[Q8B2.A]/NB,
$Q8b[u]_hybrid[Q8B2.A]/NB,
$Q8b[u]_total[Q8B2.A]/B,
R,F,
XT = "Q8b[u]. GENERAL FINANCIAL TRANSACTIONS METHODS (P[u]M) - INCIDENCE - [Q8B2STUBS.A]",
X = "
TOTAL INCIDENCE;
NON-DIGITAL/ OFFLINE ONLY;
TOTAL NON-DIGITAL/ OFFLINE;
DIGITAL;
`    DIGITAL ONLY;
`    HYBRID (BOTH DIGITAL AND OFFLINE);
DID NOT DO THIS TRANSACTION;
Missing Answer<z>; 
Total Count<c>",

DM $TQ8b[u]_inci[A]rb = 
$Q8b[u]_total[Q8B2.A]/NB,
$Q8b[u]_offlineonly[Q8B2.A]/NB,
$Q8b[u]_offlineonly[Q8B2.A]/NB+$Q8b[u]_hybrid[Q8B2.A]/NB,
$Q8b[u]_digitalonly[Q8B2.A]/NB+$Q8b[u]_hybrid[Q8B2.A]/NB,
$Q8b[u]_digitalonly[Q8B2.A]/NB,
$Q8b[u]_hybrid[Q8B2.A]/NB,
$Q8b[u]_total[Q8B2.A]/B+R,
F,
XT = "Q8b[u]. GENERAL FINANCIAL TRANSACTIONS METHODS (P[u]M) - INCIDENCE - [Q8B2STUBS.A] - REBASED",
X = "
TOTAL INCIDENCE;
NON-DIGITAL/ OFFLINE ONLY;
TOTAL NON-DIGITAL/ OFFLINE;
DIGITAL;
`    DIGITAL ONLY;
`    HYBRID (BOTH DIGITAL AND OFFLINE);
DID NOT DO THIS TRANSACTION;
Total Count<c>",
[*END A]



DM $TQ8b[u]_inci_rb_RGD = 
$Q8b[u]_totalrgd/NB,
$Q8b[u]_offlineonlyrgd/NB,
$Q8b[u]_offlineonlyrgd/NB+$Q8b[u]_hybridrgd/NB,
$Q8b[u]_digitalonlyrgd/NB+$Q8b[u]_hybridrgd/NB,
$Q8b[u]_digitalonlyrgd/NB,
$Q8b[u]_hybridrgd/NB,
$Q8b[u]_totalrgd/B+R,
F,
XT = "Q8b[u]. GENERAL FINANCIAL TRANSACTIONS METHODS (P[u]M) - INCIDENCE - REGARDLESS - REBASED",
X = "
TOTAL INCIDENCE;
NON-DIGITAL/ OFFLINE ONLY;
TOTAL NON-DIGITAL/ OFFLINE;
DIGITAL;
`    DIGITAL ONLY;
`    HYBRID (BOTH DIGITAL AND OFFLINE);
DID NOT DO THIS TRANSACTION;
Total Count<c>",


DM $Q8b[u]_RGD = 
[*DO A = 1:Q8blen]
$T_Q8b[u]_[Q8B2.A]/5..10,
[*END A]

DM $TQ8b[u]_count = 
[*DO B = 1:Q8blen]
CT($Q8b[u]_RGD)/[B],
[*END B]
F,
XT = "Q8b[u]. Average # of transactions done in the P[u]M",
X = "
1 TRANSACTION ONLY <V1>;

[*DO B = 2:Q8blen]
[B] TRANSACTIONS <V[B]>;
[*END B]
Total Count<c>",

[*DO D = 2:6]
DM $TQ8b[u]_count[D] = 
[*DO B = 1:Q8blen]
(CT($Q8b[u]_RGD)/[B]).([*DO A = 1:Q8blen]$TQ8b[u]_inci[A]/[D][*SLE]+[*END A]),
[*END B]
F,
XT = "Q8b[u]. Average # of transactions done in the P[u]M - [averageQ8btitle.[D-1]]",
X = "
1 TRANSACTION ONLY <V1>;

[*DO B = 2:Q8blen]
[B] TRANSACTIONS <V[B]>;
[*END B]
Total Count<c>",
[*END D]



[*DATA combicodes = 
1,
2,
3,
4,
5,
6,
7]
!combicodes are the number of codes in the variable, this are not the literal codes
!we have 7 codes so i put 1,2,3,4,5,6,7 in the dataset
 

 !WORKS ONLY UPTO 19!
DM $TQ8b[u]_combi =
 
[*DO R = 1:7]! [R] COMBINATION
CT($Q8b[u]_RGD)/[R],
[*DO A = 1:7]! code [A]
[*DO B = [A]:7]
[*DO C = [B]:7]
[*DO D = [C]:7]
[*DO E = [D]:7]
[*DO F = [E]:7]
[*DO G = [F]:7]
 
[*BLOCK 2 ON R.EQ.1]
[*BLOCK 1 ON A.EQ.B][*BLOCK 1 ON B.EQ.C][*BLOCK 1 ON C.EQ.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.2]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.EQ.C][*BLOCK 1 ON C.EQ.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.3]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.EQ.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.4]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.5]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.NE.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.6]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.NE.E][*BLOCK 1 ON E.NE.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.7]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.NE.E][*BLOCK 1 ON E.NE.F][*BLOCK 1 ON F.NE.G]
[*2]
CT($Q8b[u]_RGD)/[R].$Q8b[u]_RGD/([*DO Y = 1:[R]][combicodes.[~Y]][*SLE].[*END Y]),
[*1]
[*END G]
[*END F]
[*END E]
[*END D]
[*END C]
[*END B]
[*END A]
[*END R]

R,F,
 
VT = "Q8B[u]. Combination data (Permutation of transactions) - P[u]M",
V = "
[*DO R = 1:7]
COMBINATION [R]<Q>;
[*DO A = 1:7]
[*DO B = [A]:7]
[*DO C = [B]:7]
[*DO D = [C]:7]
[*DO E = [D]:7]
[*DO F = [E]:7]
[*DO G = [F]:7]
 
[*BLOCK 2 ON R.EQ.1]
[*BLOCK 1 ON A.EQ.B][*BLOCK 1 ON B.EQ.C][*BLOCK 1 ON C.EQ.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.2]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.EQ.C][*BLOCK 1 ON C.EQ.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.3]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.EQ.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.4]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.EQ.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.5]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.NE.E][*BLOCK 1 ON E.EQ.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.6]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.NE.E][*BLOCK 1 ON E.NE.F][*BLOCK 1 ON F.EQ.G]
[*2]
 
[*BLOCK 2 ON R.EQ.7]
[*BLOCK 1 ON A.NE.B][*BLOCK 1 ON B.NE.C][*BLOCK 1 ON C.NE.D][*BLOCK 1 ON D.NE.E][*BLOCK 1 ON E.NE.F][*BLOCK 1 ON F.NE.G]
[*2]
`     [*DO Y = 1:[R]][Q8B2STUBS.[~Y]][*SLE] + [*END Y];
[*1]
[*END G]
[*END F]
[*END E]
[*END D]
[*END C]
[*END B]
[*END A]
